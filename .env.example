# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# WhatsApp Phone Number (Country code + number without plus, e.g. 923298024266)
PHONE_NUMBER=923298024266

# Web Server Port
PORT=3000

# Connection Mode: "pairing" or "qr"
AUTH_MODE=pairing
