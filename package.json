{
  "name": "whatsapp-ai-agent",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "pm2:start": "npx pm2 start src/server.js --name whatsapp-ai-agent --max-restarts 50",
    "pm2:stop": "npx pm2 stop whatsapp-ai-agent",
    "pm2:restart": "npx pm2 restart whatsapp-ai-agent",
    "pm2:logs": "npx pm2 logs whatsapp-ai-agent"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@google/generative-ai": "^0.24.1",
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^6.7.24",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "fluent-ffmpeg": "^2.1.3",
    "groq-sdk": "^1.6.0",
    "msedge-tts": "^2.0.7",
    "pino": "^9.14.0",
    "pm2": "^7.0.4",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  }
}
